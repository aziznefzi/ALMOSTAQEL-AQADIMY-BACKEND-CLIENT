# =============================================================================
# Almostaqel Aqademy - Backend Client Environment Variables Example
# Copy this file to .env and replace all placeholder values with real secrets.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
ADMIN_PORT=4000
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# User JWT Secrets
ACCESS_TOKEN=replace_with_strong_random_access_token_secret
REFRESH_TOKEN=replace_with_strong_random_refresh_token_secret

# Admin Dashboard Credentials & Secrets
ADMIN_DASHBORD_USER=admin@example.com
ADMIN_DASHBORD_PASS=replace_with_strong_admin_password
ADMIN_TOKEN_SECRET=replace_with_strong_random_admin_jwt_secret
ADMIN_DEVISE_ID=replace_with_authorized_admin_device_fingerprint

# Email Providers (Resend Primary + Gmail Nodemailer Fallback)
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=replace_with_gmail_app_password

# Google OAuth & reCAPTCHA
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
RECAPTION_SECRET_KEY=replace_with_recaptcha_secret_key

# AI Chat (Gemini)
GIMINI_API_KEN=replace_with_gemini_api_key

# Payment RIB Details (Optional Overrides)
RIB_FLOUCI=replace_with_flouci_rib
RIB_ZITOUNA=replace_with_zitouna_rib
RIB_D17=replace_with_d17_rib

# External AI Agent (Creao) Articles API Key
# Generate a strong random 64-character hex key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_AGENT_API_KEY=a7f3c91e4b82d06f5e2a9c41d8b73f05e6a1c2d4f8b90e3a7c5d2f1e8b4a6c90
